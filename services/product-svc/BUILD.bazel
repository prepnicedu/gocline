load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel/oci:go_image.bzl", "go_image")

go_library(
    name = "product-svc_lib",
    srcs = ["main.go"],
    importpath = "example.com/my_project/services/product-svc",
    visibility = ["//visibility:private"],
    deps = [
        "//gen/go/product/v1:product",
        "//pkg/core",
        "//services/product-svc/cmd",
        "//services/product-svc/internal/repository",
        "//services/product-svc/internal/service",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//reflection",
    ],
)

go_binary(
    name = "product-svc",
    embed = [":product-svc_lib"],
    visibility = ["//visibility:public"],
)

go_image(
    name = "image",
    binary = "product-svc",
)
