load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel/oci:go_image.bzl", "go_image")

go_library(
    name = "user-svc_lib",
    srcs = ["main.go"],
    importpath = "gocline.com/ws/services/user-svc",
    visibility = ["//visibility:private"],
    deps = [
        "//gen/go/user/v1:user",
        "//pkg/core/config",
        "//services/user-svc/database",
        "//services/user-svc/internal",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//reflection",
    ],
)

go_binary(
    name = "user-svc",
    embed = [":user-svc_lib"],
    visibility = ["//visibility:public"],
)

go_image(
    name = "image",
    binary = "user-svc",
)
