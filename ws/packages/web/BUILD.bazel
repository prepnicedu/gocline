load("@aspect_rules_js//js:defs.bzl", "js_run_devserver")
load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//packages/web:vite/package_json.bzl", "bin")

npm_link_all_packages(name = "node_modules")

ts_project(
    name = "web",
    srcs = [
        "src/App.tsx",
        "src/main.tsx",
        "vite.config.ts",
    ],
    assets = [
        "src/App.css",
        "src/assets/hero.png",
        "src/assets/react.svg",
        "src/assets/vite.svg",
        "src/index.css",
    ],
    transpiler = swc,
    tsconfig = ":tsconfig",
    deps = [
        ":node_modules/@ours/lib",
        ":node_modules/@rolldown/plugin-babel",
        ":node_modules/@tailwindcss/vite",
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
        ":node_modules/@vitejs/plugin-react",
        ":node_modules/react",
        ":node_modules/react-dom",
        ":node_modules/vite",
    ],
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = [":__subpackages__"],
    deps = [
        ":tsconfig.app.json",
        ":tsconfig.node.json",
    ],
)

bin.vite_binary(name = "vite")

js_run_devserver(
    name = "dev",
    args = [
        "packages/web",
        "--host",
    ],
    # data = [
    #     "index.html",
    #     ":web",
    # ] + glob(["src/*"]),
    data = [
        "index.html",
        "package.json",        # <-- Fixes Vite's ESM/CommonJS warning
        "vite.config.ts",
        "tsconfig.json",
        "tsconfig.app.json",
        "tsconfig.node.json",
        ":node_modules",       # <-- Mounts all deps natively for Vite resolver
    ] + glob(["src/**/*", "public/**/*"], allow_empty = True), # <-- Give Vite raw sources (no :web target)
    tool = "vite",
)
